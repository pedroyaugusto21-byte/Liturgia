--- a/teurgica.css	2026-10-15 19:37:32.311134262 +0000
+++ teurgica.css	2026-10-16 19:11:38.944560681 +0000
@@ -128,3 +128,137 @@
 @media (max-width: 480px) {
   .festa-local-title { font-size: 24px; margin-bottom: 20px; }
 }
+
+/* ======================================================================
+   ABA 5 — TEÚRGICA (navegação, sub-abas, Hinário, Diário)
+   ====================================================================== */
+
+/* botões de navegação da aba 5 (tamanho dos demais; svg 52 px, 40 px no mobile) */
+.nav-btn.teurgica-target { color: #c9a45c; }
+.choice-teurgica .sym { color: #c9a45c; }
+.choice-teurgica .sym svg { width: 52px; height: 52px; }
+@media (max-width: 560px) { .choice-teurgica .sym svg { width: 40px; height: 40px; } }
+
+#teurgicaView { display: none; }
+#teurgicaView [hidden] { display: none !important; }
+#teurgicaView .teu-wrap { max-width: 980px; margin: 0 auto; padding: 40px 20px calc(96px + env(safe-area-inset-bottom, 0px)); }
+#teurgicaView h1 { font-family: 'Cormorant Garamond', serif; font-size: 36px; text-align: center; font-weight: 500; color: var(--teu-text); }
+@media (min-width: 900px) { #teurgicaView h1 { font-size: 44px; } }
+#teurgicaView .teu-lede { margin: 12px auto 24px; font-size: 14px; line-height: 1.6; color: var(--teu-muted); max-width: 580px; text-align: center; }
+#teurgicaView .teu-vazio { text-align: center; font-size: 15px; line-height: 1.6; color: var(--teu-muted); padding: 24px 0; }
+
+/* sub-abas */
+#teurgicaView .teu-tabs { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; margin: 0 auto 28px; }
+#teurgicaView .teu-tab {
+  display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; cursor: pointer;
+  border-radius: 999px; border: 1px solid rgba(201, 164, 92, .4); background: transparent; color: var(--teu-text);
+  font-family: 'Jost', system-ui, sans-serif; font-size: 12px; letter-spacing: .16em; text-transform: uppercase;
+}
+#teurgicaView .teu-tab:hover { background: rgba(201, 164, 92, .12); }
+/* selecionada: preenchimento + negrito + barra inferior (não depende só da cor; aria-selected para leitor de tela) */
+#teurgicaView .teu-tab[aria-selected="true"] {
+  background: rgba(201, 164, 92, .2); border-color: var(--teu-gold-hi); color: var(--teu-gold-hi); font-weight: 700;
+  box-shadow: inset 0 -3px 0 var(--teu-gold-hi);
+}
+
+/* Hinário */
+#teurgicaView .teu-hinos { display: grid; gap: 14px; max-width: 760px; margin: 0 auto; }
+#teurgicaView .teu-hino { border: 1px solid rgba(201, 164, 92, .22); border-radius: 12px; background: rgba(201, 164, 92, .04); }
+#teurgicaView .teu-hino[open] { background: rgba(201, 164, 92, .07); }
+#teurgicaView .teu-hino-h {
+  display: flex; align-items: baseline; flex-wrap: wrap; gap: .3rem .7rem; min-height: 36px; padding: 14px 18px;
+  cursor: pointer; list-style: none; border-radius: 12px;
+}
+#teurgicaView .teu-hino-h::-webkit-details-marker { display: none; }
+#teurgicaView .teu-hino-h:hover .teu-hino-t { text-decoration: underline; text-decoration-color: var(--teu-gold); text-underline-offset: 4px; }
+#teurgicaView .teu-chev { display: inline-block; width: 1em; flex: 0 0 auto; color: var(--teu-gold); font-size: .9rem; }
+#teurgicaView .teu-chev::before { content: '\25B8'; }
+#teurgicaView .teu-hino[open] .teu-chev::before { content: '\25BE'; }
+#teurgicaView .teu-hino-t { font-family: 'Cormorant Garamond', serif; font-size: 21px; font-weight: 600; color: var(--teu-gold-hi); }
+#teurgicaView .teu-hino-i { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--teu-gold); }
+#teurgicaView .teu-hino-texto {
+  padding: 2px 18px 20px 46px; font-family: 'Cormorant Garamond', serif; font-size: 19px; line-height: 1.6;
+  white-space: pre-line; overflow-wrap: anywhere; color: var(--teu-text);
+}
+
+/* Diário: mostrador + carimbo */
+#teurgicaView .teu-diario-topo { display: flex; align-items: center; justify-content: center; gap: 28px; margin-bottom: 28px; }
+#teurgicaView .teu-dial { width: 190px; flex: 0 0 auto; }
+#teurgicaView .teu-dial svg { width: 100%; height: auto; display: block; }
+#teurgicaView .teu-stamp { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
+#teurgicaView .teu-hora { font-family: 'Cinzel', serif; font-size: 30px; font-weight: 500; letter-spacing: .08em; color: var(--teu-gold-hi); font-variant-numeric: tabular-nums; }
+#teurgicaView .teu-dataext { font-size: 14px; color: var(--teu-muted); }
+#teurgicaView .teu-data-sel { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
+#teurgicaView .teu-data-sel label { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--teu-muted); }
+#teurgicaView .teu-data-sel input {
+  min-height: 36px; padding: 4px 8px; border-radius: 8px; border: 1px solid rgba(201, 164, 92, .35);
+  background: var(--teu-bg); color: var(--teu-text); font-family: 'Jost', system-ui, sans-serif; font-size: 14px; color-scheme: dark;
+}
+
+/* Diário: corpo em duas colunas */
+#teurgicaView .teu-diario-corpo { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 24px; align-items: start; }
+#teurgicaView .teu-diario-esq { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
+#teurgicaView .teu-lab { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--teu-gold); }
+#teurgicaView #teuTexto {
+  width: 100%; min-height: 220px; padding: 12px 14px; border-radius: 10px; resize: vertical;
+  border: 1px solid rgba(201, 164, 92, .4); background: var(--teu-bg); color: var(--teu-text);
+  font-family: 'Jost', system-ui, sans-serif; font-size: 16px; line-height: 1.55;
+}
+#teurgicaView .teu-acoes { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; }
+#teurgicaView .teu-estado { font-size: 14px; line-height: 1.4; color: var(--teu-green); font-weight: 500; }
+#teurgicaView .teu-estado.teu-erro { color: #E0816A; }
+#teurgicaView .teu-estado:empty { display: none; }
+
+#teurgicaView .teu-btn {
+  min-height: 40px; padding: 0 20px; border-radius: 8px; cursor: pointer;
+  border: 1px solid rgba(201, 164, 92, .55); background: transparent; color: var(--teu-gold);
+  font-family: 'Jost', system-ui, sans-serif; font-size: 14px; letter-spacing: .04em;
+}
+#teurgicaView .teu-btn:hover { background: rgba(201, 164, 92, .14); }
+#teurgicaView .teu-btn-ok { background: var(--teu-gold); border-color: var(--teu-gold); color: var(--teu-bg); font-weight: 600; }
+#teurgicaView .teu-btn-ok:hover { background: var(--teu-gold-hi); }
+#teurgicaView .teu-btn-disc { min-height: 36px; padding: 0 14px; font-size: 12px; border-color: rgba(129, 151, 170, .45); color: var(--teu-muted); }
+#teurgicaView .teu-btn-disc:hover { color: var(--teu-gold); border-color: var(--teu-gold); }
+
+/* Clima */
+#teurgicaView .teu-clima { border: 1px solid rgba(201, 164, 92, .25); border-radius: 12px; background: rgba(201, 164, 92, .04); padding: 14px 16px 16px; }
+#teurgicaView .teu-clima-h { font-family: 'Cinzel', serif; font-size: 14px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; color: var(--teu-gold); margin-bottom: 10px; }
+#teurgicaView .teu-clima-grupo { display: flex; align-items: flex-start; gap: 10px; padding: 8px 0; border-top: 1px solid rgba(201, 164, 92, .14); }
+#teurgicaView .teu-per-sym { flex: 0 0 28px; text-align: center; font-family: 'Noto Sans Symbols 2', 'Noto Sans Symbols', serif; font-size: 22px; line-height: 36px; color: var(--teu-gold); }
+#teurgicaView .teu-chips { display: flex; flex-wrap: wrap; gap: 6px; min-width: 0; }
+#teurgicaView .teu-chip {
+  min-height: 36px; padding: 0 12px; border-radius: 999px; cursor: pointer;
+  border: 1px solid rgba(201, 164, 92, .4); background: transparent; color: var(--teu-text);
+  font-family: 'Jost', system-ui, sans-serif; font-size: 13px;
+}
+#teurgicaView .teu-chip:hover { background: rgba(201, 164, 92, .14); }
+/* marcado: preenchimento + borda + negrito + "✓" (não depende só da cor; aria-pressed para leitor de tela) */
+#teurgicaView .teu-chip[aria-pressed="true"] { background: rgba(201, 164, 92, .28); border-color: var(--teu-gold-hi); color: var(--teu-gold-hi); font-weight: 700; }
+#teurgicaView .teu-chip[aria-pressed="true"]::before { content: '✓ '; }
+
+/* salvamentos e cópia */
+#teurgicaView .teu-salvos { margin-top: 24px; }
+#teurgicaView .teu-salvos h2 { font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--teu-gold); margin-bottom: 8px; }
+#teurgicaView .teu-salvos ul { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 18px; }
+#teurgicaView .teu-salvos li { font-size: 14px; color: var(--teu-text); }
+#teurgicaView .teu-salvo-h { font-family: ui-monospace, monospace; color: var(--teu-gold-hi); }
+#teurgicaView .teu-salvo-a, #teurgicaView .teu-salvo-vazio { color: var(--teu-muted); }
+#teurgicaView .teu-copia { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 32px; padding-top: 16px; border-top: 1px solid rgba(201, 164, 92, .14); }
+
+@media (max-width: 720px) {
+  #teurgicaView .teu-diario-corpo { grid-template-columns: minmax(0, 1fr); }
+  #teurgicaView .teu-diario-topo { flex-direction: column; gap: 14px; }
+  #teurgicaView .teu-stamp { align-items: center; text-align: center; }
+  #teurgicaView .teu-data-sel { justify-content: center; }
+}
+@media (max-width: 560px) {
+  #teurgicaView .teu-wrap { padding: 28px 16px calc(96px + env(safe-area-inset-bottom, 0px)); }
+  #teurgicaView h1 { font-size: 28px; }
+  #teurgicaView .teu-tab { padding: 0 12px; letter-spacing: .1em; }
+  #teurgicaView .teu-hino-texto { padding-left: 18px; }
+}
+@media (max-width: 420px) {
+  #teurgicaView .teu-tabs { gap: 4px; flex-wrap: nowrap; }
+  #teurgicaView .teu-tab { padding: 0 8px; gap: 5px; font-size: 10px; letter-spacing: .05em; min-width: 0; }
+  #teurgicaView .teu-tab svg { width: 18px; height: 18px; }
+}
